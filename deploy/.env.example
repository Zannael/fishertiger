# Copy to .env and adjust. docker compose reads .env from this directory.

# Where the published port is bound. 127.0.0.1 keeps the stack reachable only from
# this machine. Use 0.0.0.0 to expose it on the network - read the README first,
# the API has no authentication.
BIND_ADDRESS=127.0.0.1

# Host port serving the app.
PORT=8080

# Base URL the frontend uses for API calls. Empty means same origin, which is what
# you want behind the bundled nginx. Set it only if you serve the API elsewhere.
VITE_LOCAL_API_BASE=
